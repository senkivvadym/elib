{
  "version": 6,
  "configurePresets": [
    {
      "name": "_root-config",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Host default (Auto-detect)",
      "inherits": "_root-config"
    },
    {
      "name": "gcc",
      "displayName": "GCC (Multi-Config)",
      "inherits": "_root-config",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default-debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "default-release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc",
      "configuration": "Debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc",
      "configuration": "Release"
    }
  ],
  "packagePresets": [
    {
      "name": "source-archive",
      "configurePreset": "default",
      "generators": [
        "TGZ",
        "ZIP"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "default-debug",
      "hidden": true,
      "configurePreset": "default",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": true }
    },
    {
      "name": "gcc-debug",
      "hidden": true,
      "configurePreset": "gcc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "default-release-package",
      "displayName": "Host Default: Config, Build Release, and Package Source",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "default-release" },
        { "type": "package", "name": "source-archive" }
      ]
    },
    {
      "name": "gcc",
      "displayName": "GCC: Config & Build (Debug)",
      "steps": [
        { "type": "configure", "name": "gcc" },
        { "type": "build", "name": "gcc-debug" }
      ]
    }
  ]
}
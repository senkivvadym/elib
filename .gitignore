# ==============================================================================
# C++ / CMake / VS Code / DevContainers GitIgnore
# ==============================================================================

# 1. CMake & Build Outputs
# ------------------------------------------------------------------------------
# Ignore the root build directory defined in CMakePresets.json
build/
out/
bin/
obj/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json

# 2. VS Code & Language Servers
# ------------------------------------------------------------------------------
# Ignore clangd/CMake cache directories
.cache/

# Ignore user-specific VS Code settings but keep project-wide configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/settings.local.json

# 3. Visual Studio
# ------------------------------------------------------------------------------
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
*.TMP
*.tmp

# 4. OS & Environment Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
~$*
*~
*.log